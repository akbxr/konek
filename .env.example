# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Authorized numeric Telegram User IDs (can be found via @userinfobot on Telegram)
# Separate multiple IDs with commas, e.g. 12345678,87654321
TELEGRAM_ALLOWED_USER_IDS=123456789

# Path to the herdr binary (optional, default: herdr)
HERDR_BIN_PATH=/Users/akbar/.local/bin/herdr

# Default working directory for shell commands (/sh) and new workspaces (optional)
DEFAULT_CWD=/Users/akbar/Code/projects
